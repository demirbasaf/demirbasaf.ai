---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  article?: { publishedTime: Date; tags?: string[]; image?: string };
}
const { title, description, article } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} article={article} />
  </head>
  <body>
    <Header />
    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>
    <Footer />

    <!-- Open off-site links in a new tab so the site stays put. Covers links in
         writeups too, so nothing has to be tagged by hand. -->
    <script is:inline>
      for (const a of document.querySelectorAll('a[href^="http"]')) {
        if (a.host !== location.host) {
          a.target = '_blank';
          a.rel = 'noopener noreferrer';
        }
      }
    </script>
  </body>
</html>
