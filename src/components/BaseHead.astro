---
import '../styles/global.css';
import { site } from '../config/site';
import { ui } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  article?: { publishedTime: Date; tags?: string[]; image?: string };
}
const { title, article } = Astro.props;
const description = Astro.props.description ?? ui.meta.description;
const fullTitle = title ? `${title} · ${site.title}` : `${site.title} · ${site.tagline}`;
const ogImage = new URL(article?.image ?? '/og.png', site.url).href;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogType = article ? 'article' : 'website';

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.title,
  alternateName: site.person.alternateNames,
  url: site.url,
  jobTitle: site.person.jobTitle,
  worksFor: { '@type': 'Organization', name: site.person.worksFor.name, url: site.person.worksFor.url },
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.person.location.city,
    addressCountry: site.person.location.country,
  },
  knowsAbout: site.person.knowsAbout,
  sameAs: site.person.sameAs,
};

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.title,
  url: site.url,
  inLanguage: 'en',
  author: { '@type': 'Person', name: site.title, url: site.url },
};

const articleLd = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      url: canonical,
      image: ogImage,
      inLanguage: 'en',
      datePublished: article.publishedTime.toISOString(),
      keywords: (article.tags ?? []).join(', '),
      author: { '@type': 'Person', name: site.title, url: site.url },
      publisher: { '@type': 'Person', name: site.title, url: site.url },
      mainEntityOfPage: canonical,
    }
  : null;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="canonical" href={canonical} />
<link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={site.title} />
<meta name="robots" content="index, follow, max-image-preview:large" />

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={site.title} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content="en_US" />
{article ? <meta property="article:published_time" content={article.publishedTime.toISOString()} /> : null}
{article?.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />

<!-- Structured data for search engines and AI agents. -->
<script is:inline type="application/ld+json" set:html={JSON.stringify(personLd)} />
<script is:inline type="application/ld+json" set:html={JSON.stringify(websiteLd)} />
{articleLd ? <script is:inline type="application/ld+json" set:html={JSON.stringify(articleLd)} /> : null}

<!-- Set the theme before first paint to avoid a flash of the wrong colours. -->
<script is:inline>
  (() => {
    // Light by default. Dark only when the visitor has explicitly toggled it.
    const stored = localStorage.getItem('theme');
    document.documentElement.dataset.theme = stored === 'dark' ? 'dark' : 'light';
  })();
</script>
